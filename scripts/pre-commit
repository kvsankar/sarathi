#!/bin/sh
# Sarathi local hook: run the fast Node checks from the repository root.

ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

if ! command -v npm >/dev/null 2>&1; then
    echo 'npm not found on PATH; install Node.js before committing.' 1>&2
    exit 1
fi

exec npm run check:fast
